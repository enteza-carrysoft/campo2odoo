# Odoo 18 Enterprise connection
ODOO_URL=https://miempresa.odoo.com
ODOO_DB=miempresa
ODOO_USERNAME=usuario@empresa.com
ODOO_API_KEY=

# Azure Document Intelligence
AZURE_DI_ENDPOINT=https://myresource.cognitiveservices.azure.com
AZURE_DI_KEY=
# Modelo de Azure DI (por defecto prebuilt-invoice; admite modelos personalizados)
AZURE_DI_MODEL_ID=prebuilt-invoice

# LLM extractor (opt-in)
LLM_EXTRACTION_ENABLED=false
OPENROUTER_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-4-6

# App
# Contraseña de acceso a la app. OBLIGATORIA en producción (sin ella la app queda bloqueada).
APP_PASSWORD=
NEXT_PUBLIC_APP_TITLE=Campo2Odoo
